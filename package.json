{
  "name": "public-domain-hunter",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm --workspace frontend run build",
    "typecheck": "tsc -p tsconfig.worker.json && npm --workspace frontend run typecheck",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.140.0",
    "tsx": "^4.20.5"
  }
}
