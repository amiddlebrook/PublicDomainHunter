# Production Environment Configuration
ENVIRONMENT=production
DEBUG=False

# Database Configuration (Production)
DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@db:5432/public_domain_hunter

# Security (CHANGE THESE IN PRODUCTION)
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Keys (Add your actual keys here)
GOOGLE_TRENDS_API_KEY=your_google_trends_api_key
AMAZON_API_KEY=your_amazon_api_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_ASSOCIATE_TAG=your_associate_tag

# Email Configuration (Production)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Stripe Configuration (Production)
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS Configuration (Production - if using S3 for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# Application URLs (Production)
FRONTEND_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# Redis Configuration (Production)
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS Origins (Production - specify your actual domains)
CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# Session Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=strict
