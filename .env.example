# Public Domain Hunter - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./public_domain_hunter.db

# Security (CHANGE THIS IN PRODUCTION)
SECRET_KEY=your-secret-key-change-this-in-production-minimum-32-characters

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys (Get these from respective services)
GOOGLE_TRENDS_API_KEY=your_google_trends_api_key
AMAZON_API_KEY=your_amazon_product_api_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag

# Email Configuration (For alerts and notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Stripe Configuration (For payment processing)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS Configuration (For file storage - optional)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# Application URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# Redis Configuration (For caching - optional in development)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS Origins (Add your production domains)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=lax
